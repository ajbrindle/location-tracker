{
  "configVersion": "v3",
  "defaultLanguage": "en-US",
  "app": {
    "appType": "app",
    "appId": 26374,
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "appName": "Location Tracker",
    "vender": "Developer",
    "description": "Workout extension for location tracking"
  },
  "permissions": [
    "device:os.geolocation",
    "device:os.network"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6.0",
      "target": "4.0.0",
      "minVersion": "3.6.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "app-side": {
          "path": "app-side/index"
        },
        "data-widget": {
          "widgets": [
            {
              "path": "data-widget/common/index",
              "name": "Location Tracker",
              "runtime": {
                "ability": [
                  {
                    "type": 1,
                    "subType": [1, 3, 4]
                  }
                ]
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  }
}